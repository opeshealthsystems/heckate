{
  "expo": {
    "name": "HEKATE",
    "slug": "hekate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hekatesystems.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0B1A33"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hekatesystems.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#062245",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "HEKATE uses Face ID to unlock the app when you return to it."
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#062245"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HEKATE records your position when you check in and out at a client site."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HEKATE lets you attach photos to incidents and expense claims.",
          "cameraPermission": "HEKATE lets you photograph a problem or a receipt to attach it."
        }
      ],
      "expo-status-bar",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "hekate",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9a55a70b-14b0-403c-9257-ba1916a172f0"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9a55a70b-14b0-403c-9257-ba1916a172f0",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
