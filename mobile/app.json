{
  "expo": {
    "name": "HEKATE",
    "slug": "hekate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hekatesystems.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#062245",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hekatesystems.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#062245",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "HEKATE uses Face ID to unlock the app when you return to it."
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#062245"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HEKATE records your position when you check in and out at a client site."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HEKATE lets you attach photos to incidents and expense claims.",
          "cameraPermission": "HEKATE lets you photograph a problem or a receipt to attach it."
        }
      ]
    ],
    "scheme": "hekate"
  }
}
