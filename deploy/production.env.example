# HEKATE API production settings. Copy to your secret store; never commit real values.
HEKATE_ENV=production
HEKATE_DATABASE_URL=postgres://hekate:CHANGE_ME@db.internal:5432/hekate?sslmode=verify-full
HEKATE_JWKS_URL=https://auth.example.com/realms/hekate/protocol/openid-connect/certs
HEKATE_ISSUER=https://auth.example.com/realms/hekate
HEKATE_AUDIENCE=hekate-api
HEKATE_CORS_ORIGINS=https://app.example.com
HEKATE_PORTAL_URL=https://app.example.com
HEKATE_TRUSTED_PROXIES=10.0.0.0/8
HEKATE_METRICS_ADDR=127.0.0.1:9090
# HEKATE_NATS_URL=nats://nats.internal:4222
# HEKATE_QR_SIGNING_KEY_FILE=/run/secrets/qr_signing_key.pem
# PDF signing (PAdES-B-B). Off until BOTH are set; setting only one stops the API starting. Certificate PEM (leaf first,
# then intermediates) and an UNENCRYPTED private key PEM (PKCS#8, PKCS#1 RSA or SEC1 EC; RSA or ECDSA P-256/P-384),
# both mounted from the secret store, never committed. The certificate must be valid at start-up. Needs a certificate from
# a CA that Adobe/EU trust lists accept before readers show the signature as trusted. See docs/SECURITY.md (S-13).
# HEKATE_PDF_SIGNING_CERT_FILE=/run/secrets/pdf_signing_cert.pem
# HEKATE_PDF_SIGNING_KEY_FILE=/run/secrets/pdf_signing_key.pem
# HEKATE_PAYMENTS_WEBHOOK_SECRET=
# HEKATE_MOMO_* and HEKATE_ORANGE_*: leave unset until the provider issues credentials (gateways stay disabled)
