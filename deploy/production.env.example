# HEKATE API production settings. Copy to your secret store; never commit real values.
HEKATE_ENV=production
HEKATE_DATABASE_URL=postgres://hekate:CHANGE_ME@db.internal:5432/hekate?sslmode=verify-full
HEKATE_JWKS_URL=https://auth.hekatesystems.com/realms/hekate/protocol/openid-connect/certs
HEKATE_ISSUER=https://auth.hekatesystems.com/realms/hekate
HEKATE_AUDIENCE=hekate-api
HEKATE_CORS_ORIGINS=https://app.hekatesystems.com,https://hekatesystems.com,https://www.hekatesystems.com
HEKATE_PORTAL_URL=https://app.hekatesystems.com
HEKATE_TRUSTED_PROXIES=10.0.0.0/8
HEKATE_METRICS_ADDR=127.0.0.1:9090
# HEKATE_NATS_URL=nats://nats.internal:4222
# HEKATE_QR_SIGNING_KEY_FILE=/run/secrets/qr_signing_key.pem
# PDF signing (PAdES-B-B). Off until BOTH are set; setting only one stops the API starting. Certificate PEM (leaf first,
# then intermediates) and an UNENCRYPTED private key PEM (PKCS#8, PKCS#1 RSA or SEC1 EC; RSA or ECDSA P-256/P-384),
# both mounted from the secret store, never committed. The certificate must be valid at start-up. Needs a certificate from
# a CA that Adobe/EU trust lists accept before readers show the signature as trusted. See docs/SECURITY.md (S-13).
# HEKATE_PDF_SIGNING_CERT_FILE=/run/secrets/pdf_signing_cert.pem
# HEKATE_PDF_SIGNING_KEY_FILE=/run/secrets/pdf_signing_key.pem
# HEKATE_PAYMENTS_WEBHOOK_SECRET=
# HEKATE_MOMO_* and HEKATE_ORANGE_*: leave unset until the provider issues credentials (gateways stay disabled)

# Account requests (mobile "Request access"): approving one creates the Keycloak user through the admin API.
# Create a confidential client (e.g. hekate-admin-api) with only "Service accounts" enabled, give its service account
# the realm-management roles manage-users and view-realm, and configure SMTP in the realm so the set-password email goes out.
# Leave these empty to keep approvals switched off (the admin page then reports that account creation is not configured).
HEKATE_KEYCLOAK_ADMIN_URL=https://auth.hekatesystems.com/admin/realms/hekate
HEKATE_KEYCLOAK_TOKEN_URL=https://auth.hekatesystems.com/realms/hekate/protocol/openid-connect/token
HEKATE_KEYCLOAK_CLIENT_ID=hekate-admin-api
HEKATE_KEYCLOAK_CLIENT_SECRET=

# One-tap demo logins on the mobile sign-in screen: "Label|email|password;...". Created by deploy/demo/create_demo_logins.py.
# Staff demo accounts can read every organisation's data. Leave empty to hide the demo buttons (no app update needed).
HEKATE_DEMO_LOGINS=
